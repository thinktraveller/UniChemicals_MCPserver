# CAS Common Chemistry API key (申请地址: https://www.cas.org/services/commonchemistry-api)
# 将真实 key 填入项目根目录的 .env（已被 .gitignore 忽略），不要提交到仓库。
CAS_COMMON_CHEMISTRY_API_KEY=your_api_key_here

# 以下两项一般无需设置：代码内已内置当前正确的默认值，仅在 CAS 再次调整网关地址时
# 用于临时覆盖，避免必须改代码重新发版。
# 当前网关 = 官方 swagger 的 host + basePath：https://commonchemistry.cas.org/direct-api
# CAS_COMMON_CHEMISTRY_BASE_URL=https://commonchemistry.cas.org/direct-api
# 网关要求的隐藏请求头 x-origin（默认值取自官方 swagger 中该参数的 default）
# CAS_COMMON_CHEMISTRY_ORIGIN=https://commonchemistry.cas.org/api-overview
